#!/usr/bin/env bash
# NOTE: File must be UTF-8 encoded

set -e
set -o pipefail

# Requirements: Bash 4.4+ (mapfile -d, ${var,,}) and the 'timeout' command (GNU coreutils)
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "ERROR: gog requires Bash 4.4 or newer (found $BASH_VERSION). On macOS: brew install bash" >&2
  exit 1
fi
if ! command -v timeout >/dev/null 2>&1; then
  echo "ERROR: gog requires the 'timeout' command (GNU coreutils). On macOS: brew install coreutils" >&2
  exit 1
fi

export LC_ALL=C.UTF-8

# =======================
# CONFIG
# =======================
BLOCKED_BRANCHES=("main" "master")
REMOTE_TIMEOUT=5
VERSION="2.0.0"

# Exit codes
EXIT_NO_COMMIT=10
EXIT_DETACHED_HEAD=11
EXIT_BLOCKED_BRANCH=12
EXIT_REMOTE_ERROR=13
EXIT_REBASE_CONFIRM=14
EXIT_GIT_ERROR=15
EXIT_TRACKED_IGNORED=16

# =======================
# FLAGS
# =======================
SILENT=true
VERBOSE=false
REMOTE_CHECK=true
SKIP_PROTECTION=false
SYNC_NO_CHANGES=false
PULL_ONLY=false
START=false
ATTACH=false
ATTACH_URL=""
BRANCH=""
ORG=""
EXCLUDE_FILES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --start) START=true ;;
    --attach)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo "ERROR: --attach requires a remote URL (e.g. https://github.com/owner/repo.git)" >&2
        exit 1
      fi
      ATTACH=true
      ATTACH_URL="$2"
      shift
      ;;
    --attach=*)
      ATTACH=true
      ATTACH_URL="${1#--attach=}"
      if [[ -z "$ATTACH_URL" ]]; then
        echo "ERROR: --attach requires a remote URL (e.g. https://github.com/owner/repo.git)" >&2
        exit 1
      fi
      ;;
    --branch)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo "ERROR: --branch requires a branch name" >&2
        exit 1
      fi
      BRANCH="$2"
      shift
      ;;
    --branch=*)
      BRANCH="${1#--branch=}"
      if [[ -z "$BRANCH" ]]; then
        echo "ERROR: --branch requires a branch name" >&2
        exit 1
      fi
      ;;
    --org)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo "ERROR: --org requires an organization name" >&2
        exit 1
      fi
      ORG="$2"
      shift
      ;;
    --org=*)
      ORG="${1#--org=}"
      if [[ -z "$ORG" ]]; then
        echo "ERROR: --org requires an organization name" >&2
        exit 1
      fi
      ;;
    --verbose) VERBOSE=true ;;
    --remote-timeout)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo "ERROR: --remote-timeout requires a number of seconds" >&2
        exit 1
      fi
      if ! [[ "$2" =~ ^[0-9]+$ ]]; then
        echo "ERROR: --remote-timeout must be a positive integer (seconds)" >&2
        exit 1
      fi
      if [[ "$2" =~ ^0+$ ]]; then
        echo "ERROR: --remote-timeout must be greater than zero" >&2
        exit 1
      fi
      REMOTE_TIMEOUT="$2"
      shift
      ;;
    --remote-timeout=*)
      REMOTE_TIMEOUT="${1#--remote-timeout=}"
      if ! [[ "$REMOTE_TIMEOUT" =~ ^[0-9]+$ ]]; then
        echo "ERROR: --remote-timeout must be a positive integer (seconds)" >&2
        exit 1
      fi
      if [[ "$REMOTE_TIMEOUT" =~ ^0+$ ]]; then
        echo "ERROR: --remote-timeout must be greater than zero" >&2
        exit 1
      fi
      ;;
    -n|--no-remote-check) REMOTE_CHECK=false ;;
    -s|--skip-protection) SKIP_PROTECTION=true ;;
    --sync) SYNC_NO_CHANGES=true ;;
    -p|--pull) PULL_ONLY=true ;;
    -e|--exclude)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo "ERROR: -e/--exclude requires a file or pattern argument" >&2
        exit 1
      fi
      EXCLUDE_FILES+=("$2")
      shift
      ;;
    --version) echo "gog v$VERSION"; exit 0 ;;
    --help)
      cat <<EOF
Usage: gog [options] [commit message]
Options:
  --start               Initialize Git, optionally create .gitignore, and set up a GitHub repo
  --attach <url>        Attach current folder to an existing remote repository
  --branch <name>       Branch to check out when using --attach (default: auto-detect main/master)
  --org <name>          With --start: create the new GitHub repo under an organization
  --verbose             Force verbose output
  --remote-timeout <n>  Override remote reachability timeout in seconds (default: 5)
  -n,--no-remote-check  Skip remote availability check
  -s,--skip-protection  Allow committing directly to main/master
  --sync                Run the pull/push phase even if there is nothing to commit
  -p,--pull             Pull current branch from origin without committing or pushing
  -e,--exclude <file>   Exclude a file/pattern from the commit
  Tracked ignored files: prompt to stop tracking, keeping local copies
  --                    End of options (use before a commit message that starts with '-')
  --version             Show the current gog version
  --help                Show this help
EOF
      exit 0 ;;
    --) shift; break ;;
    -*)
      echo "ERROR: Unknown option: $1" >&2
      echo "To use a commit message that starts with '-', put -- before it: gog -- \"-message\"" >&2
      exit 1 ;;
    *) break ;;
  esac
  shift
done

if [[ -n "$ORG" ]]; then
  if [[ "$START" == false ]]; then
    echo "ERROR: --org only works with --start" >&2
    exit 1
  fi
  if [[ ! "$ORG" =~ ^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$ ]]; then
    echo "ERROR: --org must be a valid GitHub organization/user name (letters, digits, single hyphens between them; no leading/trailing/consecutive hyphens, spaces, or slashes)." >&2
    exit 1
  fi
fi

if [[ "$ATTACH" == true && "$START" == true ]]; then
  echo "ERROR: --attach and --start cannot be used together" >&2
  exit 1
fi

if [[ -n "$BRANCH" && "$ATTACH" == false ]]; then
  echo "ERROR: --branch only works with --attach" >&2
  exit 1
fi

if [[ "$PULL_ONLY" == true ]]; then
  if [[ "$START" == true || "$ATTACH" == true || "$SYNC_NO_CHANGES" == true || "$SKIP_PROTECTION" == true || "$REMOTE_CHECK" == false || ${#EXCLUDE_FILES[@]} -gt 0 || $# -gt 0 ]]; then
    echo "ERROR: -p/--pull cannot be combined with commit, setup, or other workflow options." >&2
    exit 1
  fi
fi

# Force interactive output visibility during startup workflows
if [[ "$VERBOSE" == true || "$START" == true || "$ATTACH" == true ]]; then
  SILENT=false
fi

log() {
  if [[ "$SILENT" == false ]]; then
    echo "$1"
  fi
}

pull_rebase() {
  if ! git pull --rebase --autostash origin "$CURRENT_BRANCH"; then
    if [[ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" || -d "$(git rev-parse --git-path rebase-apply 2>/dev/null)" ]]; then
      echo "ERROR: Rebase conflict detected! Resolve manually then run: git rebase --continue" >&2
      exit $EXIT_REBASE_CONFIRM
    elif [[ -n "$(git ls-files -u)" ]]; then
      echo "ERROR: Pull left unmerged files. Resolve the conflicts and check 'git stash list' for an autostash." >&2
      exit $EXIT_REBASE_CONFIRM
    else
      echo "ERROR: 'git pull --rebase' failed (network, auth, or diverged history) — see output above." >&2
      exit $EXIT_REMOTE_ERROR
    fi
  fi

  # Git can exit successfully even when reapplying its autostash leaves conflicts.
  if [[ -n "$(git ls-files -u)" ]]; then
    echo "ERROR: Pull left unmerged files. Resolve the conflicts and check 'git stash list' for an autostash." >&2
    exit $EXIT_REBASE_CONFIRM
  fi
}

# =======================
# INITIALIZATION FEATURE (--start)
# =======================
if [[ "$START" == true ]]; then
  log "Initializing new project workflow..."
  INIT_PERFORMED=false

  # Guard: refuse to run --start from inside a subdirectory of another Git repository
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
     && [[ "$(git rev-parse --show-toplevel)" != "$(pwd -P)" ]]; then
    echo "ERROR: This folder is inside another Git repository:" >&2
    echo "  $(git rev-parse --show-toplevel)" >&2
    echo "Move the folder out, or run 'git init' here if you intentionally want a nested repository." >&2
    exit 1
  fi

  # 1. Ensure GitHub CLI is installed
  if ! command -v gh &> /dev/null; then
    echo "ERROR: GitHub CLI ('gh') is required to create a remote repository automatically." >&2
    echo "Please install it (https://cli.github.com/) and authenticate using 'gh auth login'." >&2
    exit 1
  fi

  # 2. Initialize local Git repo if it doesn't exist
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log "Initializing local Git repository..."
    git init
    INIT_PERFORMED=true
  fi

  # 3. Optionally create a smart default .gitignore if missing
  if [[ ! -f .gitignore ]]; then
    printf "Create a default .gitignore? (Y/n): "
    read -r CREATE_GITIGNORE || CREATE_GITIGNORE=""
    if [[ ! "${CREATE_GITIGNORE,,}" =~ ^(n|no)$ ]]; then
    log "Creating default .gitignore..."
    cat <<EOF > .gitignore
# Logs
logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Common Dependency directories
node_modules/
jspm_packages/
.venv/
venv/
env/

# Build outputs
dist/
build/
.next/
out/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Local environment variables
.env
.env.local
.env.*.local
EOF
    fi  # end CREATE_GITIGNORE check
  fi

  # 4. Handle GitHub Remote creation
  if git remote get-url origin >/dev/null 2>&1; then
    if [[ -n "$ORG" ]]; then
      echo "ERROR: --org was provided, but remote 'origin' is already configured." >&2
      echo "Remove or change origin before creating a new organization repository." >&2
      exit $EXIT_REMOTE_ERROR
    fi
    log "Remote 'origin' already configured. Skipping GitHub repository creation."
  else
    # Sanitize directory name to be GitHub friendly (replace spaces with hyphens)
    SUGGESTED_NAME=$(basename "$PWD" | tr ' ' '-')
    
    printf "Enter GitHub repository name [default: %s]: " "$SUGGESTED_NAME"
    read -r REPO_NAME || REPO_NAME=""
    REPO_NAME=${REPO_NAME:-$SUGGESTED_NAME}

    # Applies regardless of --org: a slash in the name would silently retarget
    # the repo to a different owner via 'gh repo create'.
    if [[ "$REPO_NAME" == */* ]]; then
      echo "ERROR: Repository name must not contain '/'. To target an organization, use --org <name> instead." >&2
      exit 1
    fi

    printf "Make repository Public? (y/N): "
    read -r IS_PUBLIC || IS_PUBLIC=""
    VISIBILITY="--private"
    if [[ "${IS_PUBLIC,,}" =~ ^(y|yes)$ ]]; then
      VISIBILITY="--public"
    fi

    REPO_TARGET="$REPO_NAME"

    if [[ -n "$ORG" ]]; then
      REPO_TARGET="$ORG/$REPO_NAME"
    fi

    log "Creating GitHub repository '$REPO_TARGET' ($VISIBILITY)..."
    if ! gh repo create "$REPO_TARGET" "$VISIBILITY" --source=. --remote=origin; then
      echo "ERROR: Failed to create GitHub repository via 'gh' CLI." >&2
      exit $EXIT_REMOTE_ERROR
    fi
    INIT_PERFORMED=true
  fi

  # Only bypass branch protection if this run actually initialized the repo
  # and/or remote. If both already existed, --start is a no-op re-run and
  # normal branch protection should still apply.
  if [[ "$INIT_PERFORMED" == true ]]; then
    log "Bypassing branch protection for initial creation push."
    SKIP_PROTECTION=true
  fi
fi

# =======================
# ATTACH TO EXISTING REMOTE (--attach)
# =======================
if [[ "$ATTACH" == true ]]; then
  log "Attaching current folder to an existing remote repository..."

  # 0. Basic URL sanity check (before any local changes)
  if [[ ! "$ATTACH_URL" =~ ^(https?://|git@) ]]; then
    echo "ERROR: Remote URL must start with http://, https://, or git@" >&2
    exit 1
  fi

  # 1. Initialize local Git repo if it doesn't exist
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log "Initializing local Git repository..."
    git init
  fi

  # 2. Refuse if origin is already configured
  if git remote get-url origin >/dev/null 2>&1; then
    echo "ERROR: Remote 'origin' is already configured." >&2
    echo "Remove it first with: git remote remove origin" >&2
    exit $EXIT_REMOTE_ERROR
  fi

  log "Adding remote origin: $ATTACH_URL"
  if ! git remote add origin "$ATTACH_URL"; then
    echo "ERROR: Failed to add remote 'origin'." >&2
    exit $EXIT_REMOTE_ERROR
  fi

  # 3. Fetch remote history
  log "Checking remote reachability..."
  if ! timeout "$REMOTE_TIMEOUT" git ls-remote origin >/dev/null 2>&1; then
    echo "ERROR: Remote not reachable within ${REMOTE_TIMEOUT}s. Check the URL, network, and authentication (or raise --remote-timeout)." >&2
    git remote remove origin 2>/dev/null || true
    exit $EXIT_REMOTE_ERROR
  fi

  # The fetch itself is not timed out: a large repository may legitimately take a while.
  log "Fetching remote history..."
  if ! git fetch origin; then
    echo "ERROR: Failed to fetch from remote." >&2
    git remote remove origin 2>/dev/null || true
    exit $EXIT_REMOTE_ERROR
  fi

  # 4. Determine target branch
  TARGET_BRANCH="$BRANCH"
  if [[ -z "$TARGET_BRANCH" ]]; then
    if git show-ref --verify --quiet refs/remotes/origin/main; then
      TARGET_BRANCH="main"
    elif git show-ref --verify --quiet refs/remotes/origin/master; then
      TARGET_BRANCH="master"
    else
      echo "ERROR: Could not auto-detect 'main' or 'master' on the remote." >&2
      echo "Specify the branch explicitly with --branch <name>" >&2
      git remote remove origin 2>/dev/null || true
      exit 1
    fi
  else
    if ! git show-ref --verify --quiet "refs/remotes/origin/$TARGET_BRANCH"; then
      echo "ERROR: Branch '$TARGET_BRANCH' does not exist on the remote." >&2
      git remote remove origin 2>/dev/null || true
      exit 1
    fi
  fi

  # 5. Attempt a normal checkout; leave any failure for the user to resolve.
  CHECKOUT_FAILED=false
  if git show-ref --verify --quiet "refs/heads/$TARGET_BRANCH"; then
    # Local branch already exists
    if ! git checkout "$TARGET_BRANCH"; then
      CHECKOUT_FAILED=true
    else
      git branch --set-upstream-to="origin/$TARGET_BRANCH" "$TARGET_BRANCH" 2>/dev/null || true
      log "Successfully attached to $ATTACH_URL (branch: $TARGET_BRANCH)"
      SKIP_PROTECTION=true
    fi
  else
    # Create local branch tracking remote
    if ! git checkout -b "$TARGET_BRANCH" "origin/$TARGET_BRANCH"; then
      CHECKOUT_FAILED=true
      # Clean up any partial state
      git branch -D "$TARGET_BRANCH" 2>/dev/null || true
    else
      log "Successfully attached to $ATTACH_URL (branch: $TARGET_BRANCH)"
      SKIP_PROTECTION=true
    fi
  fi

  # 6. Stop if Git could not check out the remote branch.
  if [[ "$CHECKOUT_FAILED" == true ]]; then
    # Remove the origin added by this attempt so attach can be retried after resolution.
    if ! git remote remove origin 2>/dev/null; then
      echo "ERROR: Could not check out remote branch '$TARGET_BRANCH' and failed to remove origin." >&2
      echo "Resolve the Git error above, then remove origin with 'git remote remove origin'." >&2
      exit 1
    fi
    echo "ERROR: Could not check out remote branch '$TARGET_BRANCH'." >&2
    echo "Resolve the Git error above, then retry --attach." >&2
    exit 1
  fi
fi

# =======================
# PRE-CHECKS
# =======================
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "ERROR: Not a Git repository" >&2; exit 1; }

if ! CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null); then
  echo "Detached HEAD state detected" >&2; exit $EXIT_DETACHED_HEAD
fi

if [[ "$PULL_ONLY" == true ]]; then
  git remote get-url origin >/dev/null 2>&1 || { echo "ERROR: Remote 'origin' not configured" >&2; exit $EXIT_REMOTE_ERROR; }
  if ! REMOTE_EXISTS=$(timeout "$REMOTE_TIMEOUT" git ls-remote --heads origin "refs/heads/$CURRENT_BRANCH" 2>/dev/null); then
    echo "ERROR: Could not reach remote 'origin' to check branch status." >&2
    exit $EXIT_REMOTE_ERROR
  fi
  if [[ -z "$REMOTE_EXISTS" ]]; then
    echo "ERROR: Branch '$CURRENT_BRANCH' does not exist on remote 'origin'." >&2
    exit $EXIT_REMOTE_ERROR
  fi
  log "Pulling from origin/$CURRENT_BRANCH (rebase)..."
  pull_rebase
  log "SUCCESS: pull complete"
  exit 0
fi

if [[ "$SKIP_PROTECTION" == false ]]; then
  for b in "${BLOCKED_BRANCHES[@]}"; do
    if [[ "$CURRENT_BRANCH" == "$b" ]]; then
      echo "Direct commits to '$b' blocked. Use -s to bypass." >&2; exit $EXIT_BLOCKED_BRANCH
    fi
  done
fi

# =======================
# SAFETY: TRACKED FILES MATCHING IGNORE RULES
# =======================
# Ignoring an already-tracked file does not stop Git from including it in commits.
# Check the index against all standard ignore sources, without modifying files.
IGNORED_TRACKED_FILES=()
mapfile -d '' -t IGNORED_TRACKED_FILES < <(
  git ls-files --cached --ignored --exclude-standard -z
)

if ((${#IGNORED_TRACKED_FILES[@]} > 0)); then
  printf 'WARNING: %d tracked file(s) match Git ignore rules:\n' "${#IGNORED_TRACKED_FILES[@]}" >&2
  for file in "${IGNORED_TRACKED_FILES[@]}"; do
    printf '  %q\n' "$file" >&2
  done
  printf '\nStop tracking these files? [y/N]: ' >&2
  CONFIRM_UNTRACK=""
  if ! IFS= read -r CONFIRM_UNTRACK; then
    printf '\nNo confirmation received. Commit canceled; tracking unchanged.\n' >&2
    exit "$EXIT_TRACKED_IGNORED"
  fi

  case "${CONFIRM_UNTRACK,,}" in
    y|yes)
      # Remove from the index only; the working-tree files stay in place.
      # One command handles paths with spaces and avoids partial per-file work.
      if ! git rm --cached -- "${IGNORED_TRACKED_FILES[@]}"; then
        printf 'ERROR: Could not stop tracking ignored files. Commit canceled.\n' >&2
        exit "$EXIT_GIT_ERROR"
      fi
      printf 'Stopped tracking %d ignored file(s). Local copies preserved.\n' "${#IGNORED_TRACKED_FILES[@]}" >&2
      printf 'The change will be included in this commit. Previous commits are unchanged.\n' >&2
      ;;
    *)
      printf 'Canceled. Tracking unchanged; no commit created.\n' >&2
      exit "$EXIT_TRACKED_IGNORED"
      ;;
  esac
fi

if [[ "$REMOTE_CHECK" == true ]]; then
  git remote get-url origin >/dev/null 2>&1 || { echo "ERROR: Remote 'origin' not configured" >&2; exit $EXIT_REMOTE_ERROR; }
  timeout "$REMOTE_TIMEOUT" git ls-remote origin >/dev/null 2>&1 || { echo "ERROR: Remote 'origin' unreachable" >&2; exit $EXIT_REMOTE_ERROR; }
fi

# =======================
# WORKFLOW
# =======================

log "Staging all changes..."
if ! git add -A; then
  echo "ERROR: 'git add -A' failed." >&2
  exit $EXIT_GIT_ERROR
fi

if [ ${#EXCLUDE_FILES[@]} -gt 0 ]; then
  log "Excluding specified files..."
  for file in "${EXCLUDE_FILES[@]}"; do
    if git rev-parse HEAD >/dev/null 2>&1; then
      if ! git reset HEAD -- "$file" >/dev/null 2>&1; then
        echo "ERROR: Could not exclude '$file' from the commit." >&2
        exit $EXIT_GIT_ERROR
      fi
    else
      if ! git rm --cached -r "$file" >/dev/null 2>&1; then
        echo "ERROR: Could not exclude '$file' from the commit." >&2
        exit $EXIT_GIT_ERROR
      fi
    fi
  done
fi

# COMMIT LOGIC
# Use the plumbing status check: 'git diff --cached' crashes if HEAD doesn't exist yet.
# grep must read all of its input (no -q): with pipefail, an early-exiting grep can make
# git status die from SIGPIPE on large change sets and be misread as "nothing to commit".
if ! git status --porcelain | grep '^[AMDRC]' >/dev/null; then
  if [[ "$SYNC_NO_CHANGES" == true ]]; then
    log "Nothing to commit, but running sync phase..."
  elif [[ "$ATTACH" == true ]]; then
    log "Nothing to commit after attach; syncing with remote..."
  else
    echo "WARNING: Nothing to commit locally. Use --sync to run the sync phase anyway." >&2
    exit $EXIT_NO_COMMIT
  fi
else
  # Polish: set specific default text if it's a fresh repository initialization or attach
  if [[ "$START" == true || "$ATTACH" == true ]]; then
    COMMIT_MSG="${*:-initial commit}"
  else
    COMMIT_MSG="${*:-auto update}"
  fi
  log "Commit: $COMMIT_MSG"
  if ! git commit -m "$COMMIT_MSG"; then
    echo "ERROR: 'git commit' failed — check output above (e.g. missing user.name/user.email, or a pre-commit hook failure)." >&2
    exit $EXIT_GIT_ERROR
  fi
fi

# SYNC LOGIC
# Check if the branch exists on the remote (origin)
if ! REMOTE_EXISTS=$(timeout "$REMOTE_TIMEOUT" git ls-remote --heads origin "refs/heads/$CURRENT_BRANCH" 2>/dev/null); then
  echo "ERROR: Could not reach remote 'origin' to check branch status." >&2
  exit $EXIT_REMOTE_ERROR
fi

if [[ -n "$REMOTE_EXISTS" ]]; then
  log "Syncing with GitHub (rebase)..."
  # --autostash: files left out of the commit with -e may still have uncommitted changes.
  pull_rebase
  
  log "Pushing to '$CURRENT_BRANCH'..."
  if ! git push origin "$CURRENT_BRANCH"; then
    echo "ERROR: Push to '$CURRENT_BRANCH' failed." >&2
    exit $EXIT_REMOTE_ERROR
  fi
else
  log "Setting upstream and pushing..."
  if ! git push -u origin "$CURRENT_BRANCH"; then
    echo "ERROR: Initial push to '$CURRENT_BRANCH' failed." >&2
    exit $EXIT_REMOTE_ERROR
  fi
fi

log "SUCCESS: gog complete"
